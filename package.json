{
  "name": "dsh-codebuddy-provider",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for CodeBuddy / WorkBuddy official accounts, with multi-account rotation, domain fallback, and manual OpenAI-compatible endpoint configuration.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "login": "node scripts/login.mjs",
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "codebuddy",
    "workbuddy",
    "llm",
    "provider"
  ],
  "files": [
    "src",
    "scripts",
    "templates",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jacklady/dsh-codebuddy-provider.git"
  },
  "homepage": "https://github.com/jacklady/dsh-codebuddy-provider",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "bin": {
    "dsh-codebuddy-login": "scripts/login.mjs"
  }
}
